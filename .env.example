# ---------------------------------------------------------------------------
# WebShield environment variables
# Copy to .env.local and fill in what you need. Every value is optional: with
# nothing configured WebShield runs in clearly labelled local demo mode and the
# Safe Demo Lab works completely offline.
# ---------------------------------------------------------------------------

# --- Supabase (optional) ---------------------------------------------------
# Enables real sign-up/login and cloud scan history. Use the project's anon
# (public) key only. NEVER put a service-role key in these variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OWASP ZAP (optional, server-side only) --------------------------------
# Base URL of an externally hosted ZAP instance, e.g. https://zap.example.com
# Do not include a trailing slash. ZAP must NOT be run as a long-lived service
# inside Vercel; host it separately and reach it over HTTPS.
ZAP_API_URL=
# ZAP API key. Server-side only - never expose it with a NEXT_PUBLIC_ prefix.
ZAP_API_KEY=
# Maximum time to wait for a ZAP scan, in milliseconds.
ZAP_SCAN_TIMEOUT_MS=900000

# --- External scan allowlist ----------------------------------------------
# Comma-separated list of domains the operator is authorised to scan. External
# scans are rejected unless the target host matches one of these entries.
# Example: staging.example.com,www.example.org
AUTHORIZED_SCAN_DOMAINS=

# --- Optional operational limits ------------------------------------------
# Requests allowed per minute per client for scan-creation endpoints.
SCAN_RATE_LIMIT_PER_MINUTE=6
